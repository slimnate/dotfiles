{
  "defaultEditor": "cursor",
  "showStatus": true,
  "showActivity": true,
  "showTags": true,
  "baseDirs": [
    "~/Documents/dev"
  ],
  "projects": [
    {
      "path": "~/.dotfiles",
      "label": "Custom Dotfiles"
    },
    {
      "path": "/usr/share/omarchy",
      "label": "Omarchy Config"
    },
    {
      "path": "~/.openclaw",
      "label": "OpenClaw Config"
    },
    {
      "path": "~/.config",
      "label": "~/.config"
    }
  ],
  "editors": [
    {
      "id": "cursor",
      "name": "Cursor",
      "command": [
        "/usr/bin/cursor",
        "-n",
        "--classic"
      ],
      "class": "cursor",
      "kind": "gui"
    },
    {
      "id": "nvim",
      "name": "Neovim",
      "command": [
        "nvim"
      ],
      "kind": "tui"
    }
  ]
}
