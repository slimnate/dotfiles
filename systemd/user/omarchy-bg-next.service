; Systemd user service to cycle Omarchy theme background
[Unit]
Description=Cycle Omarchy theme background
After=graphical-session.target

[Service]
Type=oneshot
Environment=HOME=%h
Environment=PATH=/usr/share/omarchy/bin:%h/.local/bin:/usr/local/bin:/usr/bin
Environment=XDG_RUNTIME_DIR=%t
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
ExecStart=/usr/bin/env omarchy-theme-bg-next
